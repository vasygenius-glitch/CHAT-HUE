/* Modern UI Stylesheet */

QMainWindow {
    background-color: #ffffff;
}

QWidget#sidebar {
    background-color: #f5f6fa;
    border-right: 1px solid #dcdde1;
}

QWidget {
    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    color: #2f3640;
}

/* Buttons */
QPushButton {
    background-color: #00a8ff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #0097e6;
}

QPushButton:pressed {
    background-color: #0082c8;
}

QPushButton:disabled {
    background-color: #dcdde1;
    color: #a4b0be;
}

/* Primary Action Button */
QPushButton#btnSearch {
    background-color: #4cd137;
    font-size: 15px;
    padding: 10px 20px;
}

QPushButton#btnSearch:hover {
    background-color: #44bd32;
}

QPushButton#btnSearch:pressed {
    background-color: #3b9c2b;
}

/* Inputs */
QLineEdit {
    border: 2px solid #dcdde1;
    border-radius: 6px;
    padding: 8px 12px;
    background-color: white;
    selection-background-color: #00a8ff;
}

QLineEdit:focus {
    border: 2px solid #00a8ff;
}

/* Combo Box */
QComboBox {
    border: 2px solid #dcdde1;
    border-radius: 6px;
    padding: 6px 12px;
    background-color: white;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* Slider */
QSlider::groove:horizontal {
    border: 1px solid #dcdde1;
    height: 6px;
    background: #f5f6fa;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #00a8ff;
    border: none;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #0097e6;
}

/* Table */
QTableWidget {
    background-color: white;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    gridline-color: #f5f6fa;
    selection-background-color: #e6f5ff;
    selection-color: #2f3640;
}

QHeaderView::section {
    background-color: #f5f6fa;
    padding: 6px 12px;
    border: none;
    border-bottom: 2px solid #dcdde1;
    font-weight: bold;
    color: #718093;
}

QTableWidget::item {
    padding: 4px;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #dcdde1;
    border-radius: 4px;
    text-align: center;
    background-color: white;
}

QProgressBar::chunk {
    background-color: #00a8ff;
    border-radius: 3px;
}
